// 下载页

.dl-card
  margin-top 10px
  padding 16px 20px
  border 1px solid #eceef1
  border-radius 8px
  background #fafbfc

  .dl-card-line
    display flex
    align-items center
    flex-wrap wrap
    gap 8px

  .dl-card-name
    font-size 1.2em
    font-weight 600
    color $color-text-main

  .dl-card-tag
    padding 2px 10px
    border-radius 999px
    background $color-theme-main
    color #fff
    font-size 0.85em

  .dl-card-meta
    color $color-text-secondary
    font-size 0.9em

// 忘记密码
.dl-recover
  margin-top 14px

  .dl-recover-toggle
    background none
    border none
    padding 0
    color $color-text-secondary
    font-size 0.9em
    cursor pointer
    text-decoration underline

    &:hover
      color $color-theme-main

  .dl-recover-panel
    margin-top 10px

    .dl-recover-q
      display block
      margin-bottom 6px
      color $color-text-main
      font-size 0.95em

    select.dl-recover-q
      display block
      width 100%
      max-width 420px
      padding 6px 8px
      border 1px solid #dfe3e8
      border-radius 6px
      background #fff
      color $color-text-main

    .dl-recover-row
      display flex
      gap 8px
      max-width 420px

      input
        flex 1
        padding 8px 10px
        border 1px solid #dfe3e8
        border-radius 6px
        outline none

        &:focus
          border-color $color-theme-main

      button
        padding 8px 18px
        border none
        border-radius 6px
        background $color-theme-main
        color #fff
        cursor pointer

        &:hover
          opacity 0.9

    .dl-recover-msg
      margin-top 8px
      font-size 0.9em
      color $color-text-secondary

// 解锁后注入的秘密区块
.dl-secret
  margin 20px 0

  .dl-btn
    display inline-block
    padding 12px 30px
    background $color-theme-main
    color #fff
    border-radius 8px
    font-weight 600
    text-decoration none
    transition opacity 0.2s

    &:hover
      opacity 0.88
      color #fff

  .dl-fp
    margin-top 20px
    padding 14px 16px
    border 1px solid #eaecef
    border-radius 8px
    background #f6f8fa

    .dl-fp-label
      margin-bottom 8px
      color $color-text-secondary
      font-size 0.9em

    .dl-fp-row
      display flex
      align-items center
      gap 10px

      code.dl-fp-text
        flex 1
        word-break break-all
        font-family 'Hack', monospace
        font-size 0.92em
        color $color-text-main

      .dl-copy
        flex-shrink 0
        padding 6px 14px
        border 1px solid #dfe3e8
        border-radius 6px
        background #fff
        color $color-text-main
        cursor pointer
        font-size 0.9em

        &:hover
          border-color $color-theme-main
          color $color-theme-main

    .dl-fp-hint
      margin-top 10px
      color $color-text-secondary
      font-size 0.9em

@media $mobile-m
  .dl-card
    padding 14px 16px

  .dl-secret
    .dl-fp
      .dl-fp-row
        flex-direction column
        align-items stretch
